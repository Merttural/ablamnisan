# Private Cloudflare R2 bucket. Standard storage, not Infrequent Access.
# Create an API token with Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Single private album login. Password at least 8 characters.
# Session secret at least 16 characters. Do not commit the real values.
ALBUM_PASSWORD=
ALBUM_SESSION_SECRET=
